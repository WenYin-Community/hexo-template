/* ============================================================
   WenYin Wiki — 模仿 wenyinos.com 设计体系
   紫色主色调 / Noto 字体 / 柔和阴影 / 终端风格代码块
   ============================================================ */

/* ---------- 全局变量（浅色模式） ---------- */
:root,
:root[data-theme="light"] {
  --side-content-width: 252px;
  --hue: 263deg;
  --sat: 48%;
  --light: 51%;
  --theme: #6f42c1;
  --theme-a10: rgba(111, 66, 193, 0.1);
  --theme-a20: rgba(111, 66, 193, 0.2);
  --theme-a30: rgba(111, 66, 193, 0.3);
  --accent: #4a2c82;
  --link: #6f42c1;
  --link-a20: rgba(111, 66, 193, 0.2);
  --background: #fcfafd;
  --card: #ffffff;
  --block: rgba(111, 66, 193, 0.05);
  --block-border: #e5ddf0;
  --text: #2d2140;
  --text-p1: #504a5e;
  --text-p2: rgba(80, 74, 94, 0.8);
  --text-p3: #6b5b8a;
  --text-p4: rgba(107, 91, 138, 0.7);
}

/* ---------- 深色模式（深紫基调，对应主站终端配色） ---------- */
:root[data-theme="dark"] {
  --theme: #8b5fd6;
  --theme-a10: rgba(139, 95, 214, 0.1);
  --theme-a20: rgba(139, 95, 214, 0.2);
  --theme-a30: rgba(139, 95, 214, 0.3);
  --accent: #a78bfa;
  --link: #a78bfa;
  --link-a20: rgba(167, 139, 250, 0.2);
  --background: #1e1033;
  --card: #241340;
  --block: rgba(167, 139, 250, 0.08);
  --block-border: rgba(167, 139, 250, 0.16);
  --text: #e2d6f8;
  --text-p1: #c4b5fd;
  --text-p2: rgba(196, 181, 253, 0.8);
  --text-p3: rgba(196, 181, 253, 0.6);
  --text-p4: rgba(196, 181, 253, 0.4);
}

/* ---------- 选中文本 ---------- */
::selection {
  background: rgba(111, 66, 193, 0.18);
  color: #3b2266;
}
:root[data-theme="dark"] ::selection {
  background: rgba(167, 139, 250, 0.3);
  color: #f5f0ff;
}

/* ---------- 页面背景 ---------- */
body > .sitebg {
  background: #fcfafd !important;
}
:root[data-theme="dark"] body > .sitebg {
  background: #1e1033 !important;
}

/* ---------- 侧边栏：主站 Hero 渐变 ---------- */
.l_left .sidebg {
  background-image: linear-gradient(160deg, #4a2c82 0%, #6f42c1 50%, #8b5fd6 100%) !important;
}

/* ---------- 导航栏 ---------- */
.navbar-blur:before {
  background: rgba(252, 250, 253, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
:root[data-theme="dark"] .navbar-blur:before {
  background: rgba(30, 16, 51, 0.88);
}

.navbar nav a.active,
.navbar nav a:hover {
  color: #6f42c1;
}
.navbar nav a.active {
  background: rgba(111, 66, 193, 0.08);
}
:root[data-theme="dark"] .navbar nav a.active,
:root[data-theme="dark"] .navbar nav a:hover {
  color: #a78bfa;
}
:root[data-theme="dark"] .navbar nav a.active {
  background: rgba(167, 139, 250, 0.12);
}

/* ---------- Logo 区域 ---------- */
.logo-wrap {
  min-height: 60px;
}
.logo-wrap a.avatar {
  width: 56px;
  height: 56px;
  margin-right: 1.1rem;
}
.logo-wrap a.title {
  line-height: 1.18;
}
.logo-wrap a.title .main {
  font-size: 1.36rem;
  white-space: nowrap;
  color: #fff;
  font-weight: 700;
}
.logo-wrap a.title .sub {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.75);
}

/* ---------- 标题使用衬线字体（Noto Serif SC） ---------- */
.md-text.content h1:not([class]),
.md-text.content h2:not([class]),
.md-text.content h3:not([class]) {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-weight: 700;
  color: #2d2140;
}
:root[data-theme="dark"] .md-text.content h1:not([class]),
:root[data-theme="dark"] .md-text.content h2:not([class]),
:root[data-theme="dark"] .md-text.content h3:not([class]) {
  color: #e2d6f8;
}

.widgets .widget-wrapper .widget-header {
  color: #2d2140;
  font-weight: 700;
}
:root[data-theme="dark"] .widgets .widget-wrapper .widget-header {
  color: #e2d6f8;
}

/* ---------- 正文排版 ---------- */
.md-text.content p:not([class]) {
  color: #504a5e;
  font-weight: 300;
  line-height: 1.9;
}
:root[data-theme="dark"] .md-text.content p:not([class]) {
  color: #c4b5fd;
}

/* ---------- 文章卡片 ---------- */
.l_main .post-list .post-title:hover {
  color: #6f42c1;
}
:root[data-theme="dark"] .l_main .post-list .post-title:hover {
  color: #a78bfa;
}

:root[data-theme="light"] .post-list .post-card,
:root:not([data-theme]) .post-list .post-card {
  border: 1px solid #e5ddf0;
  box-shadow: 0 4px 24px rgba(75, 44, 130, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
:root[data-theme="light"] .post-list .post-card:hover,
:root:not([data-theme]) .post-list .post-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(75, 44, 130, 0.08);
}
:root[data-theme="dark"] .post-list .post-card {
  border: 1px solid rgba(167, 139, 250, 0.14);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
}

/* ---------- 侧边栏小部件卡片 ---------- */
:root[data-theme="light"] .widgets .widget-wrapper .widget-body,
:root:not([data-theme]) .widgets .widget-wrapper .widget-body {
  border-color: #e5ddf0;
}

/* ---------- 代码块：终端风格（深紫底） ---------- */
.md-text.content pre,
.md-text.content .highlight figcaption {
  font-size: 0.875rem;
}

:root[data-theme="light"] .md-text.content .highlight,
:root:not([data-theme]) .md-text.content .highlight {
  background: #1e1033;
  border-radius: 10px;
  box-shadow: 0 20px 50px rgba(30, 16, 51, 0.15);
}
:root[data-theme="light"] .md-text.content .highlight figcaption,
:root:not([data-theme]) .md-text.content .highlight figcaption {
  background: rgba(255, 255, 255, 0.04);
  color: #a78bfa;
}
:root[data-theme="light"] .md-text.content .highlight pre,
:root:not([data-theme]) .md-text.content .highlight pre {
  color: #c4b5fd;
}
:root[data-theme="light"] .md-text.content .highlight .gutter,
:root:not([data-theme]) .md-text.content .highlight .gutter {
  background: rgba(255, 255, 255, 0.03);
  color: rgba(196, 181, 253, 0.4);
}

:root[data-theme="dark"] .md-text.content .highlight {
  background: #170c28;
  border: 1px solid rgba(167, 139, 250, 0.12);
  border-radius: 10px;
}

/* 行内代码 */
.md-text.content p > code:not([class]),
.md-text.content li > code:not([class]) {
  font-size: 95%;
  background: rgba(111, 66, 193, 0.08);
  border: 1px solid rgba(111, 66, 193, 0.15);
  border-radius: 4px;
  color: #4a2c82;
  padding: 0.1em 0.35em;
}
:root[data-theme="dark"] .md-text.content p > code:not([class]),
:root[data-theme="dark"] .md-text.content li > code:not([class]) {
  background: rgba(167, 139, 250, 0.12);
  border-color: rgba(167, 139, 250, 0.2);
  color: #c4b5fd;
}

/* ---------- 引用块 ---------- */
.md-text.content blockquote {
  border-left: 3px solid #6f42c1;
  background: rgba(111, 66, 193, 0.04);
}
:root[data-theme="dark"] .md-text.content blockquote {
  border-left-color: #a78bfa;
  background: rgba(167, 139, 250, 0.06);
}

/* ---------- 按钮 ---------- */
.md-text.content .tag-plugin.button,
button {
  transition: all 200ms ease;
}

/* ---------- 页脚 ---------- */
:root[data-theme="light"] .site-footer,
:root:not([data-theme]) .site-footer {
  background: #f5f2f8;
  border-top: 1px solid #e5ddf0;
}
:root[data-theme="dark"] .site-footer {
  background: #170c28;
  border-top: 1px solid rgba(167, 139, 250, 0.12);
}

/* ---------- 主题切换按钮 ---------- */
.theme-toggle {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 32;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid rgba(111, 66, 193, 0.22);
  border-radius: 46px;
  background: rgba(252, 250, 253, 0.92);
  color: #4a2c82;
  box-shadow: 0 4px 24px rgba(75, 44, 130, 0.06);
  padding: 0.45rem 0.75rem;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: all 200ms ease;
}
.theme-toggle:hover {
  background: #f6f2fa;
  border-color: rgba(111, 66, 193, 0.4);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(111, 66, 193, 0.12);
}
.theme-toggle[data-mode="dark"] {
  border-color: rgba(167, 139, 250, 0.3);
  background: rgba(36, 19, 64, 0.9);
  color: #e2d6f8;
}
.theme-toggle[data-mode="dark"]:hover {
  background: rgba(36, 19, 64, 1);
  border-color: rgba(167, 139, 250, 0.5);
}
.theme-toggle-icon {
  width: 0.9rem;
  height: 0.9rem;
  border-radius: 50%;
  box-shadow: inset -0.25rem -0.2rem 0 0 currentColor;
}
.theme-toggle[data-mode="dark"] .theme-toggle-icon {
  background: currentColor;
  box-shadow: 0 0 0 0.16rem rgba(167, 139, 250, 0.45);
}

/* ---------- 响应式 ---------- */
@media screen and (max-width: 667px) {
  .theme-toggle {
    top: 12px;
    right: 12px;
  }
  .logo-wrap {
    min-height: 54px;
  }
  .logo-wrap a.avatar {
    width: 50px;
    height: 50px;
    margin-right: 0.85rem;
  }
  .logo-wrap a.title .main {
    font-size: 1.05rem;
  }
  .logo-wrap a.title .sub {
    font-size: 0.82rem;
  }
}

/* ---------- 快捷导航小部件 ---------- */
.widget-wrapper.markdown .widget-body [id="快捷导航"] {
  margin-bottom: 0.35rem;
  font-size: 1rem;
  line-height: 1.3;
}
.widget-wrapper.markdown .widget-body [id="快捷导航"] + p {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.5rem;
  margin: 0.25rem 0 0;
  line-height: 1.2;
}
.widget-wrapper.markdown .widget-body [id="快捷导航"] + p br {
  display: none;
}
.widget-wrapper.markdown .widget-body [id="快捷导航"] + p a {
  display: inline-flex;
  align-items: center;
  padding: 0.1rem 0;
  font-size: 0.92rem !important;
  white-space: nowrap;
}

/* ---------- 平滑滚动 & 字体渲染 ---------- */
html {
  scroll-behavior: smooth;
}
body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ---------- 无障碍：减少动画 ---------- */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  .post-list .post-card,
  .theme-toggle {
    transition: none;
  }
}

/* ============================================================
   布局紧凑化 — 减少空白区域
   ============================================================ */

/* ---------- 全局间距收紧 ---------- */
:root {
  --gap-margin: 12px;
  --gap-padding: 14px;
  --width-main: 760px;
}
@media screen and (min-width: 2048px) {
  :root {
    --width-main: 820px;
  }
}

/* ---------- 主体区域 ---------- */
.l_main {
  padding-bottom: var(--gap-max);
}
@media screen and (min-width: 667px) {
  .l_main {
    padding-top: calc(var(--gap-margin) * 1.5);
  }
}
.l_main header {
  margin: 1rem 1rem 0.5rem;
}

/* ---------- 文章列表紧凑化 ---------- */
.l_main .post-list {
  margin: 0.5rem;
}
.l_main .post-list .post-title {
  margin: 0.75rem auto 0.5rem 0;
}
.post-list .post-card {
  margin: 0.75rem 0;
}
.post-list .md-text {
  padding: 0.75rem 1rem;
}
.post-list .post-card .excerpt {
  margin: 0.5rem 0;
}
.post-list .post-card .excerpt > p {
  margin: 0.5rem 0;
}
.post-list .post-card .post-cover {
  width: calc(100% + 2 * 1rem);
  margin-left: -1rem;
  margin-top: -0.75rem;
  margin-right: -1rem;
}

/* ---------- 文章正文紧凑化 ---------- */
.md-text.content {
  --gap-p: calc(var(--fsp) + 2px);
}
.md-text.content h2:not([class]) {
  margin-top: 2rem;
  margin-bottom: 0.75rem;
}
.md-text.content h3:not([class]) {
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
}

/* ---------- 侧边栏小部件紧凑化 ---------- */
.widgets .widget-wrapper {
  margin-bottom: 0.75rem;
}
.widgets .widget-wrapper .widget-header {
  margin-top: 0.25rem;
}
.l_left .widgets .widget-wrapper:first-child {
  margin-top: 0;
}

/* ---------- 页脚紧凑化 ---------- */
.site-footer {
  margin: 2rem 1rem 1.5rem;
}

/* ---------- 右侧栏 TOC 间距 ---------- */
.l_right .widgets .widget-wrapper .widget-body {
  padding-top: 0.5rem;
}

/* ---------- 移动端微调 ---------- */
@media screen and (max-width: 667px) {
  .l_main .post-list {
    margin: 0.25rem;
  }
  .post-list .post-card {
    margin: 0.5rem 0;
  }
  .post-list .md-text {
    padding: 0.5rem 0.75rem;
  }
}
