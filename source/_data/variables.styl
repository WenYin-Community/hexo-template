// ==============================================================
// WenYin 主站配色覆盖（与 wenyinos.com 视觉体系对齐）
// 色板：主紫 #6f42c1 / 深紫 #4a2c82 / 极深紫 #3b2266 / 背景紫 #5a3e8e
// ==============================================================

// ---- 链接 ----
$link-color            = #6f42c1;
$link-hover-color      = #4a2c82;
$link-decoration-color = #6f42c1;
$link-color-dark       = #a78bfa;
$link-hover-color-dark = #c4b5fd;

// ---- 背景 ----
$body-bg-color           = #fcfafd;
$body-bg-color-dark      = #1e1033;
$content-bg-color        = #ffffff;
$content-bg-color-dark   = #241338;
$card-bg-color           = #f6f2fb;
$card-bg-color-dark      = #2c1844;
$menu-item-bg-color      = #f6f2fb;
$menu-item-bg-color-dark = #2c1844;

// ---- 文本选中 ----
$selection-bg         = rgba(111, 66, 193, .22);
$selection-color      = #2d2140;
$selection-bg-dark    = rgba(167, 139, 250, .3);
$selection-color-dark = #f5f0ff;

// ---- 字体（与主站一致：系统字体栈，不引入外网字体）----
$font-family-base      = 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
$font-family-logo      = $font-family-base;
$font-family-headings  = 'Noto Serif SC', 'Songti SC', serif;
$font-family-posts     = $font-family-base;
$font-family-monospace = 'JetBrains Mono', 'SF Mono', 'Fira Code', Consolas, Menlo, monospace;

// ---- 侧栏导航 ----
$sidebar-nav-hover-color = #6f42c1;
$sidebar-highlight       = #6f42c1;

// ---- 品牌块（左上标题区）----
$font-size-title      = 1.5em;
$font-size-subtitle   = 0.9375em;
$site-subtitle-margin = 12px 10px 0;

// ---- 按钮（紫描边，hover 紫底白字）----
$btn-default-radius             = 6px;
$btn-default-color              = #6f42c1;
$btn-default-border-color       = #6f42c1;
$btn-default-hover-bg           = #6f42c1;
$btn-default-hover-color        = #ffffff;
$btn-default-hover-border-color = #6f42c1;

// ---- 分页 ----
$pagination-active-bg     = #6f42c1;
$pagination-active-color  = #ffffff;
$pagination-active-border = #6f42c1;
